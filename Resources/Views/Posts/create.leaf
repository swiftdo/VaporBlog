#extend("layouts/base"):
#export("title"):
创建文章
#endexport

#export("headers"):

<link href="/third/cherry-markdown-0.9.4/cherry-markdown.min.css" rel="stylesheet" />
<script src="/third/cherry-markdown-0.9.4/cherry-markdown.min.js"></script>
<script src="/third/echarts-4.6.0/echarts.min.js"></script>

<style>

</style>
#endexport


#export("body"):
<div class="container mt-4 mb-4">
    <h1 class="mb-4">创建文章</h1>
    <form id="postForm">
        <div class="mb-3">
            <label for="title" class="form-label">标题</label>
            <input type="text" class="form-control" id="title" name="title" required>
        </div>
        <div class="mb-3">
            <label for="content" class="form-label">内容(markdown)</label>
            <div id="markdown-container" id="content"style="height: 500px;"></div>
        </div>
        <div class="mb-3">
            <label for="title" class="form-label">概要</label>
            <input type="text" class="form-control" id="excerpt" name="excerpt" required>
        </div>

        <div class="mb-3">
            <label for="tags" class="form-label">分类</label>
            <select class="form-select" id="categories" name="categories" multiple>
                #for(category in categories):
                    <option value="#(category.id)">#(category.name)</option>
                #endfor
            </select>
        </div>

        <div class="mb-3">
            <label for="tags" class="form-label">标签</label>
            <select class="form-select" id="tags" name="tags" multiple>
                #for(tag in tags):
                    <option value="#(tag.id)">#(tag.name)</option>
                #endfor
            </select>
        </div>
        <button type="submit" class="btn btn-primary">提交</button>
        <a href="/page/posts" class="btn btn-secondary ms-2">返回列表</a>
    </form>
</div>
<script>

$(document).ready(function() {
    $('#tags').select2({placeholder:  "请选择标签", allowClear: true});
    $('#categories').select2({placeholder:  "请选择分类", allowClear: true});
});

const cherryInstance = new Cherry({
    id: 'markdown-container',
    value: '# 欢迎来到 VaporBlog!',
    editor: {
        defaultModel: 'editOnly'
    },
    event: {
        afterChange: function (text, html) {
            let content = getPlainTextFromCherryMarkdown(cherryInstance);
            $('#excerpt').val(content); // 更新概要内容
        }
    }
});



function getPlainTextFromCherryMarkdown(cherryInstance, maxLength = 150) {
    if (!cherryInstance) {
        console.warn("Cherry Markdown 实例未找到。");
        return '';
    }

    const htmlContent = cherryInstance.getHtml();
    const tempDiv = document.createElement('div');
    tempDiv.innerHTML = htmlContent;
    tempDiv.querySelectorAll('a, code, pre, img').forEach(el => el.remove());
    let plainText = tempDiv.textContent || tempDiv.innerText || '';
    plainText = plainText.replace(/\s+/g, ' ').trim();

    // 按字符数截取
    if (plainText.length <= maxLength) {
        return plainText;
    } else {
        return plainText.slice(0, maxLength) + '...';
    }
}

$('#postForm').on('submit', async function(e) { 
  e.preventDefault();
  const title = $('#title').val().trim();
  const excerpt = $('#excerpt').val().trim();
  const content = cherryInstance.getMarkdown();

  // 获取标签
  const selectedTags = $('#tags').val(); 

  // 获取分类
  const selectedCategories = $('#categories').val();

  try {
    const resp = await fetch('/page/posts/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ 
        "title": title,
        "excerpt": excerpt,
        "content": content,
        "status": "published",
        "tagIds": selectedTags.join(","),
        "categoryIds": selectedCategories.join(",")
     }),
    });
    if (resp.redirected) {
      window.location.href = resp.url;
      return;
    }
    const data = await resp.json();
    if (!responseSuccess(data)) {
      Swal.fire({
        title: '失败',
        text: data.message || '创建文章失败',
        icon: 'error'
      });
    }
  } catch {
    Swal.fire({
      title: '失败',
      text: '网络错误，请稍后重试',
      icon: 'error'
    });
  }
});
</script>
#endexport
#endextend