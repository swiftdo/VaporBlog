#extend("base"):
#export("title"):创建文章#endexport
#export("body"):
<h1>创建文章</h1>
<form method="post" action="/posts">
    <label>标题：<input type="text" name="title" required></label><br>
    <label>内容：<textarea name="content" rows="6"></textarea></label><br>
    <button type="submit">提交</button>
</form>
#endexport