#extend("layouts/base"):
#export("title"):
#(post.title)
#endexport

#export("headers"):
<link href="/third/cherry-markdown-0.9.4/cherry-markdown.min.css" rel="stylesheet" />
<script src="/third/cherry-markdown-0.9.4/cherry-markdown.min.js"></script>
<script src="/third/echarts-4.6.0/echarts.min.js"></script>
#endexport

#export("body"):
<div class="container mt-4 mb-4">
    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <article class="mb-4">
                <header class="mb-4">
                    <h1 class="fw-bolder mb-1">#(post.title)</h1>
                    <div class="text-muted fst-italic mb-2">
                        发布于 #date(post.createdAt, "yyyy-MM-dd") by #(post.author.nickname)
                        <span class="ms-3">👁️ #(post.viewsCount)</span>
                    </div>
                    <div>
                        #for(category in post.categories):
                            <a class="badge bg-primary text-decoration-none link-light" href="#!">#(category.name)</a>
                        #endfor
                    </div>
                </header>
                
                <textarea id="markdown-data" style="display:none">#(post.content)</textarea>
                <div id="cherry-markdown-container" class="mb-5"></div>
            </article>

            <!-- Comments Section -->
            <section class="mb-5">
                <div class="card bg-light">
                    <div class="card-body">
                        <h5 class="card-title mb-4">评论区</h5>
                        #if(user):
                        <form id="post-comment" class="mb-4">
                            <textarea name="content" id="post-comment-content" class="form-control" rows="3" placeholder="加入讨论，留下你的评论吧！" required></textarea>
                            <button type="submit" class="btn btn-primary mt-2">发表评论</button>
                        </form>
                        #else:
                        <div class="text-muted mb-4">请 <a href="/page/auth/login">登录</a> 后发表评论。</div>
                        #endif

                        <!-- Comments List -->
                        #if(count(post.comments) > 0):
                            #for(comment in post.comments):
                            <div class="d-flex mb-4">
                                <div class="flex-shrink-0"><img class="rounded-circle" src="https://dummyimage.com/50x50/ced4da/6c757d.jpg" alt="..." /></div>
                                <div class="ms-3">
                                    <div class="fw-bold">#(comment.author.nickname)</div>
                                    <div class="text-muted" style="font-size:0.9em;">#relativeDate(comment.createdAt)</div>
                                    <p>#(comment.content)</p>
                                    <button class="btn btn-link btn-sm p-0 reply-btn" data-comment="#(comment.id)">回复</button>
                                    <form class="reply-form mt-2 d-none" id="reply-form-#(comment.id)">
                                        <input type="hidden" name="parentID" value="#(comment.id)">
                                        <textarea name="content" class="form-control mb-2" rows="2" placeholder="回复 #(comment.author.nickname)..." required></textarea>
                                        <button type="submit" class="btn btn-secondary btn-sm">提交回复</button>
                                    </form>

                                    #if(comment.replies && count(comment.replies) > 0):
                                        #for(reply in comment.replies):
                                        <div class="d-flex mt-4">
                                            <div class="flex-shrink-0"><img class="rounded-circle" src="https://dummyimage.com/50x50/ced4da/6c757d.jpg" alt="..." /></div>
                                            <div class="ms-3">
                                                <div class="fw-bold">#(reply.author.nickname)</div>
                                                <div class="text-muted" style="font-size:0.9em;">#relativeDate(reply.createdAt)</div>
                                                <p>#(reply.content)</p>
                                            </div>
                                        </div>
                                        #endfor
                                    #endif
                                </div>
                            </div>
                            #endfor
                        #else:
                            <div class="text-muted">暂无评论，快来抢占沙发吧！</div>
                        #endif
                    </div>
                </div>
            </section>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Author Card -->
            <div class="card mb-4">
                <div class="card-header">关于作者</div>
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <img class="rounded-circle me-3" src="https://dummyimage.com/50x50/ced4da/6c757d.jpg" alt="..." />
                        <div>
                            <div class="fw-bold">#(post.author.nickname)</div>
                            <div class="text-muted">#(post.author.username)</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Categories Card -->
            <div class="card mb-4">
                <div class="card-header">分类</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-12">
                            <ul class="list-unstyled mb-0">
                                #for(category in post.categories):
                                    <li><a href="#!">#(category.name)</a></li>
                                #endfor
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tags Card -->
            <div class="card mb-4">
                <div class="card-header">标签</div>
                <div class="card-body">
                    #for(tag in post.tags):
                        <a class="badge bg-secondary text-decoration-none link-light me-1 mb-1" href="#!">#(tag.name)</a>
                    #endfor
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="card">
                <div class="card-header">操作</div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        #if(user && post.author && post.author.id == user.id):
                            <a href="/page/posts/#(post.id)/edit" class="btn btn-outline-secondary">✏️ 编辑</a>
                            <form method="post" action="/page/posts/#(post.id)/delete" onsubmit="return confirm('确定要删除这篇文章吗？');">
                                <button type="submit" class="btn btn-danger w-100">🗑️ 删除</button>
                            </form>
                        #endif
                        <a href="/page/posts" class="btn btn-secondary">🔙 返回列表</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(function() {
    const dynamicMarkdownContent = $('#markdown-data').val();

    const cherryInstance = new Cherry({
        id: 'cherry-markdown-container',
        value: dynamicMarkdownContent,
        editor: {
            defaultModel: 'previewOnly',
        },
        toolbars: {
            showToolbar: false,
        },
    });

    $('.reply-btn').on('click', function() {
        var cid = $(this).data('comment');
        $('#reply-form-' + cid).toggleClass('d-none');
    });

    $('#post-comment').on('submit', async function (e) {
        e.preventDefault();
        var content = $('#post-comment-content').val();
        try {
            const resp = await fetch('/page/posts/#(post.id)/comment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ "content": content }),
            });
            if (resp.redirected) {
                window.location.href = resp.url;
            } else {
                const data = await resp.json();
                if (!responseSuccess(data)) {
                    Swal.fire({ title: '失败', text: data.message || '创建文章失败', icon: 'error' });
                } else {
                    window.location.reload();
                }
            }
        } catch {
            Swal.fire({ title: '失败', text: '网络错误，请稍后重试', icon: 'error' });
        }
    });

    $('.reply-form').on('submit', async function(e) {
        e.preventDefault();
        var $form = $(this);
        var parentID = $form.find('input[name="parentID"]').val();
        var content = $form.find('textarea[name="content"]').val();
        try {
            const resp = await fetch(`/page/posts/#(post.id)/comments/${parentID}/reply`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content: content }),
            });
            if (resp.redirected) {
                window.location.href = resp.url;
            } else {
                const data = await resp.json();
                if (!responseSuccess(data)) {
                    Swal.fire({ title: '失败', text: data.message || '回复失败', icon: 'error' });
                } else {
                    window.location.reload();
                }
            }
        } catch {
            Swal.fire({ title: '失败', text: '网络错误，请稍后重试', icon: 'error' });
        }
    });
});
</script>

#endexport
#endextend
