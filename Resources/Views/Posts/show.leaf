#extend("layouts/base"):
#export("title"):
查看文章
#endexport

#export("headers"):

<link href="/third/cherry-markdown-0.9.4/cherry-markdown.min.css" rel="stylesheet" />
<script src="/third/cherry-markdown-0.9.4/cherry-markdown.min.js"></script>
<script src="/third/echarts-4.6.0/echarts.min.js"></script>
<style>

</style>
#endexport

#export("body"):
<div class="container mt-4 mb-4">
    <h1 class="mb-4">#(post.title)</h1>
    <article class="mb-4 p-3 bg-light rounded shadow-sm">
        <div>
            #for(category in post.categories):
                <span class="badge bg-primary me-1">#(category.name)</span>
            #endfor
        </div>

        #if(post.author):
        <div class="mt-3" style="color: grey"> #(post.author.nickname)</div>
        #endif

        <textarea id="markdown-data" style="display:none" >#(post.content)</textarea>

        <div class="mt-3" id="cherry-markdown-container"></div>

        <div class="mt-3">
            #for(tag in post.tags):
                <span class="badge bg-secondary me-1">#(tag.name)</span>
            #endfor
        </div>
    </article>
    <div class="d-flex gap-2">
        #if(user && post.author && post.author.id == user.id):
            <a href="/page/posts/#(post.id)/edit" class="btn btn-outline-secondary">✏️ 编辑</a>
            <form method="post" action="/page/posts/#(post.id)/delete" class="d-inline" onsubmit="return confirm('确定要删除这篇文章吗？');">
                <button type="submit" class="btn btn-danger">🗑️ 删除</button>
            </form>
        #endif
        <a href="/page/posts" class="btn btn-secondary">🔙 返回列表</a>
    </div>
</div>

<script>

$(function() {
    // 初始化 Cherry Markdown 编辑器
    const dynamicMarkdownContent =  $('#markdown-data').val();

    // 初始化 Cherry Markdown 实例，只读模式
    const cherryInstance = new Cherry({
        id: 'cherry-markdown-container', // 容器元素的 ID
        value: dynamicMarkdownContent, // 传入后端提供的 Markdown 内容
        editor: {
            defaultModel: 'previewOnly', // 只读模式
        },
        toolbars: {
            showToolbar: false, // 隐藏工具栏
        },
    });
});
</script>

#endexport
#endextend