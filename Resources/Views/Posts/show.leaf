#extend("layouts/base"):
#export("title"):
查看文章
#endexport

#export("headers"):

<link href="/third/cherry-markdown-0.9.4/cherry-markdown.min.css" rel="stylesheet" />
<script src="/third/cherry-markdown-0.9.4/cherry-markdown.min.js"></script>
<script src="/third/echarts-4.6.0/echarts.min.js"></script>
<style>

</style>
#endexport

#export("body"):
<div class="container mt-4 mb-4">
    <h1 class="mb-4">#(post.title)</h1>
    <article class="mb-4 p-3 bg-light rounded shadow-sm">
        <div>
            #for(category in post.categories):
                <span class="badge bg-primary me-1">#(category.name)</span>
            #endfor
        </div>

        #if(post.author):
        <div class="mt-3" style="color: grey"> 
            #(post.author.nickname)
            <span class="ms-3 text-muted" style="font-size: 0.95em;">👁️ #(post.viewsCount)</span>
            <span class="ms-2 text-muted" style="font-size: 0.9em;">🕜 #date(post.createdAt, "yyyy-MM-dd")</span>
        </div>
        #endif

        <textarea id="markdown-data" style="display:none" >#(post.content)</textarea>

        <div class="mt-3" id="cherry-markdown-container"></div>

        <div class="mt-3">
            #for(tag in post.tags):
                <span class="badge bg-secondary me-1">#(tag.name)</span>
            #endfor
        </div>
    </article>

    <div class="mt-4">
    <h5>评论</h5>
    <div>
        #if(user):
            <form id="post-comment" class="mt-3">
                <div class="mb-2">
                    <textarea name="content" id="post-comment-content" class="form-control" rows="3" placeholder="写下你的评论..." required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">发表评论</button>
            </form>
        #else:
            <div class="text-muted mt-2">请登录后发表评论。</div>
        #endif
    </div>

    <div class="mt-3 border rounded p-3 bg-white">
    #if(count(post.comments) > 0):
        #for(comment in post.comments):
            <div class="border-bottom py-2">
                <b>#(comment.author.nickname)</b>
                <span class="text-muted" style="font-size:0.9em;">#relativeDate(comment.createdAt)</span>
                <div>#(comment.content)</div>
                <button class="btn btn-link btn-sm p-0 reply-btn" data-comment="#(comment.id)">评论</button>
                <form class="reply-form mt-2 d-none" id="reply-form-#(comment.id)">
                    <input type="hidden" name="parentID" value="#(comment.id)">
                    <textarea name="content" class="form-control mb-2" rows="2" placeholder="回复内容..." required></textarea>
                    <button type="submit" class="btn btn-secondary btn-sm">提交回复</button>
                </form>
                #if(comment.replies && count(comment.replies) > 0):
                    <div class="ms-4 mt-2">
                        #for(reply in comment.replies):
                            <div class="border-bottom py-2">
                                <b>#(reply.author.nickname)</b>
                                <span class="text-muted" style="font-size:0.9em;">#relativeDate(reply.createdAt)</span>
                                <div>#(reply.content)</div>
                            </div>
                        #endfor
                    </div>
                #endif
            </div>
        #endfor
    #else:
        <div class="text-muted">暂无评论</div>
    #endif
    </div>

    <div class="d-flex gap-2 mt-5">
        #if(user && post.author && post.author.id == user.id):
            <a href="/page/posts/#(post.id)/edit" class="btn btn-outline-secondary">✏️ 编辑</a>
            <form method="post" action="/page/posts/#(post.id)/delete" class="d-inline" onsubmit="return confirm('确定要删除这篇文章吗？');">
                <button type="submit" class="btn btn-danger">🗑️ 删除</button>
            </form>
        #endif
        <a href="/page/posts" class="btn btn-secondary">🔙 返回列表</a>
    </div>
</div>

<script>

$(function() {
    // 初始化 Cherry Markdown 编辑器
    const dynamicMarkdownContent =  $('#markdown-data').val();

    // 初始化 Cherry Markdown 实例，只读模式
    const cherryInstance = new Cherry({
        id: 'cherry-markdown-container', // 容器元素的 ID
        value: dynamicMarkdownContent, // 传入后端提供的 Markdown 内容
        editor: {
            defaultModel: 'previewOnly', // 只读模式
        },
        toolbars: {
            showToolbar: false, // 隐藏工具栏
        },
    });

    // 展开/收起回复表单
    $('.reply-btn').on('click', function() {
        var cid = $(this).data('comment');
        $('#reply-form-' + cid).toggleClass('d-none');
    });


    $('#post-comment').on('submit', async function (e) {
        e.preventDefault();

        var content = $('#post-comment-content').val();

        // 发表评论
        try {
            const resp = await fetch('/page/posts/#(post.id)/comment',  {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    "content": content
                }),
            });
            if (resp.redirected) {
                window.location.href = resp.url;
                return;
            }
            const data = await resp.json();
            if (!responseSuccess(data)) {
                Swal.fire({
                    title: '失败',
                    text: data.message || '创建文章失败',
                    icon: 'error'
                });
            }
        } catch {
            Swal.fire({
                title: '失败',
                text: '网络错误，请稍后重试',
                icon: 'error'
            });
        }
    });

    $('.reply-form').on('submit', async function(e) {
        e.preventDefault();
        var $form = $(this);
        var parentID = $form.find('input[name="parentID"]').val();
        var content = $form.find('textarea[name="content"]').val();

        try {
            const resp = await fetch(`/page/posts/#(post.id)/comments/${parentID}/reply`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    content: content,
                }),
            });
            if (resp.redirected) {
                window.location.href = resp.url;
                return;
            }
            const data = await resp.json();
            if (!responseSuccess(data)) {
                Swal.fire({
                    title: '失败',
                    text: data.message || '回复失败',
                    icon: 'error'
                });
            } else {
                // 回复成功后刷新页面或动态插入新回复
                window.location.reload();
            }
        } catch {
            Swal.fire({
                title: '失败',
                text: '网络错误，请稍后重试',
                icon: 'error'
            });
        }
    });
});
</script>

#endexport
#endextend