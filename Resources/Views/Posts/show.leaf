#extend("base"):
#export("title"):查看文章#endexport
#export("body"):
<h1>#(post.title)</h1>
<article>
    <p>#(post.content)</p>
</article>
<a href="/page/posts/#(post.id)/edit">✏️ 编辑</a>
<form method="post" action="/page/posts/#(post.id)">
    <input type="hidden" name="_method" value="delete"/>
    <button type="submit">🗑️ 删除</button>
</form>
<a href="/page/posts">🔙 返回列表</a>
#endexport
#endextend
