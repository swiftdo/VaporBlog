#extend("layouts/base"):
#export("title"):
编辑文章
#endexport

#export("body"):
<div class="container mt-4" style="max-width: 600px;">
    <h1 class="mb-4">编辑文章</h1>
    <form method="post" action="/page/posts/#(post.id)/update">
        <div class="mb-3">
            <label for="title" class="form-label">标题</label>
            <input type="text" class="form-control" id="title" name="title" value="#(post.title)" required>
        </div>
        <div class="mb-3">
            <label for="content" class="form-label">内容</label>
            <textarea class="form-control" id="content" name="content" rows="6">#(post.content)</textarea>
        </div>
        <button type="submit" class="btn btn-primary">保存修改</button>
        <a href="/page/posts" class="btn btn-secondary ms-2">返回列表</a>
    </form>
</div>
#endexport

#endextend