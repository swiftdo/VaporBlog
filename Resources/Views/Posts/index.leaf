#extend("layouts/base"):

#export("title"):
文章列表
#endexport

#export("topSide"):
<div class="text-center py-5 mb-4 bg-light rounded">
        <h1 class="display-2 fw-bold hero-title">全部文章</h1>
        <p class="lead text-secondary fw-normal">发现优质技术内容，与技术专家深度交流</p>
        
        <div class="mt-4">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="搜索文章、作者、标签..." aria-label="搜索文章">
                <button class="btn btn-outline-primary" type="button"><i class="ri-search-line"></i></button>
            </div>
            
        </div>
</div>
#endexport

#export("body"):
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2><i class="ri-star-line me-2"></i>文章</h2>
        <a href="/page/posts/editors-picks" class="btn btn-outline-primary btn-sm">刷选 <i class="ri-arrow-right-line"></i></a>
    </div>
    

    <div class="row">
        #for(post in items):
        <div class="col-md-12 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            #if(post.author):
                                <span class="text-muted">#(post.author.nickname)</span>
                            #endif
                        </div>
                        <div>
                            #for(category in post.categories):
                                <span class="badge bg-secondary me-1">#(category.name)</span>
                            #endfor
                            <span class="text-muted ms-2"><i class="ri-timer-line me-1"></i>5 分钟</span>
                        </div>
                    </div>

                    <h4 class="card-title mb-2"><a href="/page/posts/#(post.id)" class="text-decoration-none text-dark">#(post.title)</a></h4>

                    #if(post.excerpt):
                    <p class="card-text text-secondary mb-3">#(post.excerpt)</p>
                    #endif

                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <div class="text-muted" style="font-size: 0.9em;">
                            <span class="me-3"><i class="ri-calendar-line me-1"></i>#relativeDate(post.createdAt)</span>
                            <span class="me-3"><i class="ri-eye-line me-1"></i>123</span>
                            <span class="me-3"><i class="ri-chat-3-line me-1"></i>45</span>
                        </div>
                        <a href="/page/posts/#(post.id)" class="btn btn-sm text-dark text-decoration-none">阅读全文 <i class="ri-arrow-right-line"></i></a>
                    </div>

                    <div class="mt-3">
                        #for(tag in post.tags):
                            <span class="badge badge-tag me-1"><i class="ri-bookmark-line me-1"></i>#(tag.name)</span>
                        #endfor
                    </div>
                </div>
            </div>
        </div>
        #endfor
    </div>
    <div class="text-center mt-4 mb-5">
        <button class="btn btn-outline-primary" onclick="loadMoreArticles()">加载更多</button>
    </div>
#endexport


#export("rightSide"):
#extend("partials/sidebar")
#endexport



#endextend




