#extend("layouts/base"):

#export("title"):
文章列表
#endexport
#export("body"):
    <div class="container mt-4">
        <h1 class="mb-4">所有文章</h1>

        #if(user):
            <a href="/page/posts/create" class="btn btn-primary mb-3">➕ 创建新文章</a>
        #else:
        #endif
        <ul class="list-group">
        #for(post in posts):
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <a href="/page/posts/#(post.id)" class="fw-bold">#(post.title)</a>
                </div>
                <div>
                    <a href="/page/posts/#(post.id)/edit" class="btn btn-sm btn-outline-secondary me-2">编辑</a>
                    <form method="post" action="/page/posts/#(post.id)/delete" class="d-inline" onsubmit="return confirm('确定要删除这篇文章吗？');">
                        <button type="submit" class="btn btn-sm btn-danger">删除</button>
                    </form>
                </div>
            </li>
        #endfor
        </ul>
    </div>
#endexport

#endextend