<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>#(title)</title>
    
    <link href="/third/bootstrap-5.3.6/bootstrap.min.css" rel="stylesheet" />
    <link href="/third/sweetalert2-11.22.2/sweetalert2.min.css" rel="stylesheet" />
    <link href="/third/select2-4.1.0-rc.0/select2.min.css" rel="stylesheet" >
    <link href="/third/remixIcon-4.6.0/remixicon.css" rel="stylesheet">
    
    <script src="/third/jquery-3.7.1/jquery.min.js"></script>
    <link href="/styles/custom.css" rel="stylesheet" />
    #import("headers")
</head>
<body class="d-flex flex-column min-vh-100">
    #extend("partials/header")
    
    <div class="text-center py-5 mb-4 bg-light rounded">
        <h1 class="display-2 fw-bold hero-title">技术思考的<br>聚集地</h1>
        <p class="lead text-secondary fw-normal">汇聚优秀的技术文章，分享深度的编程见解，<br>在这里与技术大脑进行思想碰撞</p>
        <div class="d-flex justify-content-center mt-4">
            <div class="px-3 border-end">
                <div class="fs-4 fw-bold">123</div>
                <div class="text-muted">精品文章</div>
            </div>
            <div class="px-3 border-end">
                <div class="fs-4 fw-bold">45</div>
                <div class="text-muted">技术作者</div>
            </div>
            <div class="px-3">
                <div class="fs-4 fw-bold">12345</div>
                <div class="text-muted">月阅读量</div>
            </div>
        </div>
        <div class="mt-4">
            <a href="#" class="btn btn-primary"><i class="ri-search-line me-2"></i>搜索内容</a>
        </div>
    </div>

    <main class="flex-fill container mt-4">
        <div class="row">
            <div class="col-md-8">
                #flash()
                #import("body")
            </div>
            <div class="col-md-4">
                #extend("partials/sidebar")
            </div>
        </div>
    </main>

    #extend("partials/footer")
    <script src="/third/bootstrap-5.3.6/bootstrap.bundle.min.js"></script>
    <script src="/scripts/common.js"></script>
    <script src="/third/sweetalert2-11.22.2/sweetalert2.all.min.js"></script>
    <script src="/third/select2-4.1.0-rc.0/select2.min.js"></script>
</body>
</html>