<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>#(title)</title>
    <link href="/third/bootstrap-5.3.6/bootstrap.min.css" rel="stylesheet" />
    <link href="/third/cherry-markdown-0.9.4/cherry-markdown.min.css" rel="stylesheet" />
    <script src="/third/cherry-markdown-0.9.4/cherry-markdown.min.js"></script>
    <link href="/third/sweetalert2-11.22.2/sweetalert2.min.css" rel="stylesheet" />
    #import("styles")
</head>
<body class="d-flex flex-column min-vh-100">
    #extend("partials/header")
    
    <main class="flex-fill">
        #flash()
        #import("body")
    </main>
    #extend("partials/footer")
    <script src="/third/bootstrap-5.3.6/bootstrap.bundle.min.js"></script>
    <script src="/scripts/common.js"></script>
    <script src="/third/sweetalert2-11.22.2/sweetalert2.all.min.js"></script>
</body>
</html>
